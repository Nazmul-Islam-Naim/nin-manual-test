DATABASE_URL=sqlite:///./data/app.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000
ALLOW_PRIVATE_URLS=true
URL_CHECK_TIMEOUT_S=10
# Spec 003 - manual parsing (LLM). claude_cli = local personal use only (logged-in claude CLI)
LLM_PROVIDER=claude_cli
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT_S=600
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PARSE_CHUNK_CHARS=12000
LLM_HTTP_TIMEOUT_S=120
# Spec 004 - visible menu sweep (executor subprocess; needs: python -m playwright install chromium)
EXEC_HEADED=true
# pause (ms) after highlight/click/sample fill in phase 1 only; 0 or fast_mode disables
EXEC_SLOW_MO_MS=300
MAX_MENUS=30
EXEC_PAGE_TIMEOUT_S=15
# time budget when the execute body has no max_minutes; reaching it ends the run 'done', not 'failed'
EXEC_OVERALL_TIMEOUT_S=3600
# Spec 004 / instruction 011 - form submit testing on each visited menu page
EXEC_SUBMIT_FORMS=true
MAX_FORMS_PER_PAGE=5
MAX_FORMS=50
# Instruction 013 - validation matrix (basic | standard | thorough; per-request override validation_depth)
EXEC_VALIDATION_DEPTH=thorough
MAX_CASES_PER_FORM=25
MAX_CASES=200
# Instruction 014 - page actions (buttons, tabs, links inside pages; per-request override test_actions)
EXEC_TEST_ACTIONS=true
MAX_ACTIONS_PER_PAGE=15
MAX_ACTIONS=150
# extra comma-separated words that must never be clicked (added to the built-in denylist)
ACTION_DENY_EXTRA=
